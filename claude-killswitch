#!/bin/bash

set -eu
set -o pipefail
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
umask 077

PRODUCT_NAME="Claude Kill Switch for macOS"
PRODUCT_VERSION="1.0.4"
ANCHOR_NAME="io.github.claude-killswitch.macos"
ANCHOR_FILE="/etc/pf.anchors/${ANCHOR_NAME}"
PF_CONF="/etc/pf.conf"
INSTALL_PATH="/usr/local/sbin/claude-killswitch"
DAEMON_LABEL="io.github.claude-killswitch.macos"
DAEMON_PLIST="/Library/LaunchDaemons/${DAEMON_LABEL}.plist"
STATE_DIR="/var/db/${ANCHOR_NAME}"
STATE_FILE="${STATE_DIR}/state"
BACKUP_DIR="/var/backups/${ANCHOR_NAME}"
BEGIN_MARKER="# BEGIN ${ANCHOR_NAME}"
END_MARKER="# END ${ANCHOR_NAME}"
ANTHROPIC_IPV4="160.79.104.0/23, 153.61.224.0/22"
PUBLIC_IPV6="2000::/3, 64:ff9b::/96, 64:ff9b:1::/48"
BAIT_CANDIDATES="223.5.5.5:443 1.1.1.1:443 9.9.9.9:443"
TEMP_DIR=""
VERIFY_ACTIVE=0
VERIFY_ROUTE_ADDED=0
VERIFY_GATEWAY=""
VERIFY_ADDRESS=""
VERIFY_INTERFACE=""
VERIFY_RULES_CHANGED=0

cleanup() {
  local result
  result=0
  if [ "$VERIFY_RULES_CHANGED" -eq 1 ]; then
    if /sbin/pfctl -a "$ANCHOR_NAME" -f "$ANCHOR_FILE" >/dev/null 2>&1 && runtime_rules_complete; then
      VERIFY_RULES_CHANGED=0
    else
      say "错误：正式防护恢复未确认，请运行 status 检查。" >&2
      result=1
    fi
  fi
  if ! remove_test_route; then
    say "错误：测试路由清理未确认；保留失败状态，不能视为验收通过。" >&2
    result=1
  fi
  if [ -n "$TEMP_DIR" ] && [ -d "$TEMP_DIR" ]; then
    /bin/rm -rf "$TEMP_DIR" || result=1
    TEMP_DIR=""
  fi
  return "$result"
}

finish() {
  local result
  result=$1
  trap - EXIT
  if ! cleanup; then result=1; fi
  exit "$result"
}

trap 'finish "$?"' EXIT
trap 'exit 130' HUP INT TERM

say() {
  printf '%s\n' "$*"
}

fail() {
  printf '错误：%s\n' "$*" >&2
  exit 1
}

unverified() {
  say "未验证：$*" >&2
  exit 2
}

path_metadata_safe() {
  local owner mode acl
  owner=$1
  mode=$2
  acl=$3
  [ "$owner" = "0" ] || return 1
  case "$mode" in ''|*[!0-7]*) return 1 ;; esac
  [ "$((8#$mode & 0022))" -eq 0 ] || return 1
  # Deny ACLs are normal on macOS. Any extra write-granting ACL requires
  # manual review instead of silently trusting a privileged execution path.
  if printf '%s\n' "$acl" | awk '
    / allow / && /write|append|add_file|add_subdirectory|delete|chown/ { bad=1 }
    END { exit !bad }
  '; then return 1; fi
}

secure_path() {
  local path current part metadata owner mode acl old_ifs
  path=$1
  # These are the standard system aliases, not arbitrary user symlinks.
  case "$path" in
    /etc/*) path="/private/etc/${path#/etc/}" ;;
    /var/*) path="/private/var/${path#/var/}" ;;
  esac
  current=""
  old_ifs=$IFS
  IFS=/
  for part in $path; do
    [ -n "$part" ] || continue
    current="${current}/${part}"
    [ ! -L "$current" ] || { IFS=$old_ifs; return 1; }
    if [ -e "$current" ]; then
      metadata=$(/usr/bin/stat -f '%u %Lp' "$current") || { IFS=$old_ifs; return 1; }
      owner=${metadata%% *}
      mode=${metadata#* }
      acl=$(/bin/ls -lde "$current") || { IFS=$old_ifs; return 1; }
      path_metadata_safe "$owner" "$mode" "$acl" || { IFS=$old_ifs; return 1; }
    fi
  done
  IFS=$old_ifs
}

assert_secure_installation_paths() {
  local path
  for path in "$INSTALL_PATH" "$DAEMON_PLIST" "$ANCHOR_FILE" "$PF_CONF" "$STATE_DIR" "$STATE_FILE" "$BACKUP_DIR"; do
    secure_path "$path" || fail "拒绝使用不安全的安装路径（所有者、写权限、ACL 或符号链接异常）。"
  done
}

require_root() {
  local action
  action=$1
  [ "$(id -u)" -eq 0 ] || fail "请使用 sudo 运行：sudo \"${0}\" ${action}"
}

make_temp_dir() {
  mktemp -d "/private/tmp/claude-killswitch.XXXXXX"
}

physical_interfaces() {
  local ports
  ports=$(/usr/sbin/networksetup -listallhardwareports 2>/dev/null) || {
    say "错误：无法读取物理网卡，覆盖范围未确认。" >&2
    return 1
  }
  printf '%s\n' "$ports" | awk '
    /^Device:/ {
      if ($2 ~ /^en[0-9]+$/ || $2 ~ /^bridge[0-9]+$/) print $2
    }
  ' | sort -u
}

strip_managed_block() {
  local input_file output_file
  input_file=$1
  output_file=$2
  awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
    $0 == begin { skipping=1; next }
    $0 == end { skipping=0; next }
    !skipping { print }
  ' "$input_file" > "$output_file"
}

write_anchor() {
  local output_file interfaces interface
  output_file=$1
  interfaces=$2

  {
    say "# Managed by ${PRODUCT_NAME} ${PRODUCT_VERSION}"
    say "# Source: https://platform.claude.com/docs/en/api/ip-addresses"
    say "table <anthropic_ipv4> const { ${ANTHROPIC_IPV4} }"
    say "# Block public IPv6 and NAT64 on physical interfaces to prevent proxy bypass."
    say "table <public_ipv6> const { ${PUBLIC_IPV6} }"
    say ""
    printf '%s\n' "$interfaces" | while IFS= read -r interface; do
      [ -n "$interface" ] || continue
      say "block drop out quick on ${interface} inet from any to <anthropic_ipv4>"
      say "block drop out quick on ${interface} inet6 from any to <public_ipv6>"
    done
  } > "$output_file"
}

write_pf_candidate() {
  local output_file stripped_file
  output_file=$1
  stripped_file=$2

  strip_managed_block "$PF_CONF" "$stripped_file"
  {
    sed -e '${/^$/d;}' "$stripped_file"
    say ""
    say "$BEGIN_MARKER"
    say "anchor \"${ANCHOR_NAME}\""
    say "load anchor \"${ANCHOR_NAME}\" from \"${ANCHOR_FILE}\""
    say "$END_MARKER"
  } > "$output_file"
}

pf_status() {
  /sbin/pfctl -s info 2>/dev/null | awk '/^Status:/ { print $2; exit }'
}

save_initial_state() {
  local state_pf backup_file token state_temp
  state_pf=$1
  backup_file=$2
  token=${3:-}

  /bin/mkdir -p "$STATE_DIR"
  state_temp="${STATE_FILE}.new"
  {
    say "PF_WAS_ENABLED=${state_pf}"
    say "PF_TOKEN=${token}"
    say "ORIGINAL_BACKUP=${backup_file}"
  } > "$state_temp"
  /usr/sbin/chown root:wheel "$state_temp"
  /bin/chmod 600 "$state_temp"
  /bin/mv "$state_temp" "$STATE_FILE"
}

update_state_token() {
  local pf_was_enabled backup_file token
  token=$1
  [ -r "$STATE_FILE" ] || return 0
  pf_was_enabled=$(awk -F= '/^PF_WAS_ENABLED=/ { print $2; exit }' "$STATE_FILE")
  backup_file=$(awk -F= '/^ORIGINAL_BACKUP=/ { print $2; exit }' "$STATE_FILE")
  save_initial_state "$pf_was_enabled" "$backup_file" "$token"
}

write_daemon_plist() {
  local output_file
  output_file=$1
  {
    say '<?xml version="1.0" encoding="UTF-8"?>'
    say '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
    say '<plist version="1.0">'
    say '<dict>'
    say '  <key>Label</key>'
    say "  <string>${DAEMON_LABEL}</string>"
    say '  <key>ProgramArguments</key>'
    say '  <array>'
    say "    <string>${INSTALL_PATH}</string>"
    say '    <string>watch</string>'
    say '  </array>'
    say '  <key>RunAtLoad</key>'
    say '  <true/>'
    say '  <key>KeepAlive</key>'
    say '  <true/>'
    say '  <key>ThrottleInterval</key>'
    say '  <integer>10</integer>'
    say '  <key>ProcessType</key>'
    say '  <string>Background</string>'
    say '  <key>StandardOutPath</key>'
    say '  <string>/dev/null</string>'
    say '  <key>StandardErrorPath</key>'
    say '  <string>/dev/null</string>'
    say '</dict>'
    say '</plist>'
  } > "$output_file"
}

daemon_active() {
  /bin/launchctl print "system/${DAEMON_LABEL}" 2>/dev/null \
    | grep -q '^[[:space:]]*state = running$'
}

install_daemon() {
  local plist_candidate attempt
  plist_candidate="${TEMP_DIR}/daemon.plist"
  write_daemon_plist "$plist_candidate"
  /usr/bin/plutil -lint "$plist_candidate" >/dev/null
  /usr/bin/install -o root -g wheel -m 644 "$plist_candidate" "$DAEMON_PLIST"
  /bin/launchctl enable "system/${DAEMON_LABEL}" >/dev/null
  # Keep the existing launchd registration on upgrades. Rules stay loaded
  # while launchd restarts the watcher from the newly installed executable.
  if /bin/launchctl print "system/${DAEMON_LABEL}" >/dev/null 2>&1; then
    /bin/launchctl kickstart -k "system/${DAEMON_LABEL}" >/dev/null
  else
    attempt=0
    until /bin/launchctl bootstrap system "$DAEMON_PLIST" >/dev/null 2>&1; do
      attempt=$((attempt + 1))
      [ "$attempt" -lt 5 ] || fail "守护服务注册失败；防护规则仍保留，请检查 launchd 状态"
      /bin/sleep 1
    done
  fi
  attempt=0
  until daemon_active; do
    attempt=$((attempt + 1))
    [ "$attempt" -lt 10 ] || fail "守护服务未进入运行状态；防护规则仍保留"
    /bin/sleep 1
  done
}

normalize_networks() {
  tr ',' '\n' | awk '{$1=$1; if (NF) print}' | LC_ALL=C sort -u
}

file_table_complete() {
  local table expected actual
  table=$1
  expected=$(printf '%s\n' "$2" | normalize_networks)
  actual=$(awk -v name="$table" '
    $1 == "table" && $2 == "<" name ">" {
      sub(/^[^{]*\{/, ""); sub(/\}.*/, ""); print
    }
  ' "$ANCHOR_FILE" | normalize_networks)
  [ "$actual" = "$expected" ]
}

runtime_table_complete() {
  local table expected actual
  table=$1
  expected=$(printf '%s\n' "$2" | normalize_networks)
  actual=$(/sbin/pfctl -a "$ANCHOR_NAME" -t "$table" -T show 2>/dev/null) || return 1
  actual=$(printf '%s\n' "$actual" | normalize_networks)
  [ "$actual" = "$expected" ]
}

interface_rules_complete() {
  local interfaces rules interface
  interfaces=$1
  rules=$2
  printf '%s\n' "$interfaces" | while IFS= read -r interface; do
    [ -n "$interface" ] || continue
    printf '%s\n' "$rules" | grep -Fqx "block drop out quick on ${interface} inet from any to <anthropic_ipv4>" || exit 9
    printf '%s\n' "$rules" | grep -Fqx "block drop out quick on ${interface} inet6 from any to <public_ipv6>" || exit 9
  done
}

configuration_complete() {
  local interfaces rules
  [ -r "$ANCHOR_FILE" ] || return 1
  [ -r "$PF_CONF" ] || return 1
  grep -qF "$BEGIN_MARKER" "$PF_CONF" || return 1
  grep -Fqx "anchor \"${ANCHOR_NAME}\"" "$PF_CONF" || return 1
  grep -Fqx "load anchor \"${ANCHOR_NAME}\" from \"${ANCHOR_FILE}\"" "$PF_CONF" || return 1
  file_table_complete anthropic_ipv4 "$ANTHROPIC_IPV4" || return 1
  file_table_complete public_ipv6 "$PUBLIC_IPV6" || return 1
  interfaces=$(physical_interfaces)
  [ -n "$interfaces" ] || return 1
  rules=$(cat "$ANCHOR_FILE")
  interface_rules_complete "$interfaces" "$rules"
}

runtime_anchor_referenced() {
  /sbin/pfctl -sr 2>/dev/null | grep -Fqx "anchor \"${ANCHOR_NAME}\" all"
}

runtime_rules_complete() {
  local interfaces rules
  [ "$(pf_status || true)" = "Enabled" ] || return 1
  runtime_anchor_referenced || return 1
  runtime_table_complete anthropic_ipv4 "$ANTHROPIC_IPV4" || return 1
  runtime_table_complete public_ipv6 "$PUBLIC_IPV6" || return 1
  interfaces=$(physical_interfaces)
  [ -n "$interfaces" ] || return 1
  rules=$(/sbin/pfctl -a "$ANCHOR_NAME" -sr 2>/dev/null) || return 1
  interface_rules_complete "$interfaces" "$rules"
}

ensure_pf_runtime() {
  local enable_output pf_token
  if runtime_anchor_referenced; then
    /sbin/pfctl -a "$ANCHOR_NAME" -f "$ANCHOR_FILE" >/dev/null 2>&1
  else
    /sbin/pfctl -f "$PF_CONF" >/dev/null 2>&1
  fi
  if [ "$(pf_status || true)" != "Enabled" ]; then
    enable_output=$(/sbin/pfctl -E 2>&1)
    pf_token=$(printf '%s\n' "$enable_output" | awk '/Token/ { print $NF; exit }')
    [ -n "$pf_token" ] && update_state_token "$pf_token"
  fi
}

install_rules() {
  local mode
  local interfaces anchor_candidate pf_candidate pf_validation pf_stripped
  local previous_pf previous_anchor timestamp backup_file current_pf
  local pf_was_enabled pf_token enable_output load_result
  mode=${1:-install}
  require_root install
  assert_secure_installation_paths
  [ -r "$PF_CONF" ] || fail "找不到 ${PF_CONF}"

  interfaces=$(physical_interfaces)
  [ -n "$interfaces" ] || fail "没有识别到物理网络接口"

  TEMP_DIR=$(make_temp_dir)
  anchor_candidate="${TEMP_DIR}/anchor"
  pf_candidate="${TEMP_DIR}/pf.conf"
  pf_validation="${TEMP_DIR}/pf.validation"
  pf_stripped="${TEMP_DIR}/pf.stripped"
  previous_pf="${TEMP_DIR}/pf.previous"
  previous_anchor="${TEMP_DIR}/anchor.previous"

  /bin/cp "$PF_CONF" "$previous_pf"
  if [ -e "$ANCHOR_FILE" ]; then
    /bin/cp "$ANCHOR_FILE" "$previous_anchor"
  fi

  write_anchor "$anchor_candidate" "$interfaces"
  write_pf_candidate "$pf_candidate" "$pf_stripped"
  sed "s#${ANCHOR_FILE}#${anchor_candidate}#" "$pf_candidate" > "$pf_validation"
  /sbin/pfctl -nf "$anchor_candidate" >/dev/null
  /sbin/pfctl -nf "$pf_validation" >/dev/null

  timestamp=$(/bin/date '+%Y%m%d-%H%M%S')
  /bin/mkdir -p "$BACKUP_DIR"
  backup_file="${BACKUP_DIR}/pf.conf.${timestamp}"
  /bin/cp -p "$PF_CONF" "$backup_file"

  current_pf=$(pf_status || true)
  if [ "$current_pf" = "Enabled" ]; then
    pf_was_enabled=1
  else
    pf_was_enabled=0
  fi

  /bin/mkdir -p "$(dirname "$ANCHOR_FILE")" "$(dirname "$INSTALL_PATH")"
  /usr/bin/install -o root -g wheel -m 644 "$anchor_candidate" "$ANCHOR_FILE"
  /usr/bin/install -o root -g wheel -m 644 "$pf_candidate" "$PF_CONF"
  if [ "$mode" = "install" ] && { [ ! -e "$INSTALL_PATH" ] || [ ! "$0" -ef "$INSTALL_PATH" ]; }; then
    /usr/bin/install -o root -g wheel -m 755 "$0" "$INSTALL_PATH"
  fi

  # On an ordinary upgrade the main configuration is unchanged. Reload
  # only our anchor so system-managed rules are left in place.
  if cmp -s "$previous_pf" "$PF_CONF" && runtime_anchor_referenced; then
    load_result=0
    /sbin/pfctl -a "$ANCHOR_NAME" -f "$ANCHOR_FILE" >/dev/null || load_result=$?
  else
    load_result=0
    /sbin/pfctl -f "$PF_CONF" >/dev/null || load_result=$?
  fi
  if [ "$load_result" -ne 0 ]; then
    /usr/bin/install -o root -g wheel -m 644 "$previous_pf" "$PF_CONF"
    if [ -e "$previous_anchor" ]; then
      /usr/bin/install -o root -g wheel -m 644 "$previous_anchor" "$ANCHOR_FILE"
    else
      /bin/rm -f "$ANCHOR_FILE"
    fi
    /sbin/pfctl -f "$PF_CONF" >/dev/null 2>&1 || fail "载入和回滚均失败，请检查 pf 状态"
    fail "载入失败；原配置已重新载入，请用原版本 status 复核"
  fi

  pf_token=""
  if [ "$pf_was_enabled" -eq 0 ]; then
    enable_output=$(/sbin/pfctl -E 2>&1) || {
      /usr/bin/install -o root -g wheel -m 644 "$previous_pf" "$PF_CONF"
      if [ -e "$previous_anchor" ]; then
        /usr/bin/install -o root -g wheel -m 644 "$previous_anchor" "$ANCHOR_FILE"
      else
        /bin/rm -f "$ANCHOR_FILE"
      fi
      /sbin/pfctl -f "$PF_CONF" >/dev/null 2>&1 || fail "启用与配置回滚均失败，请检查 pf 状态"
      fail "启用 pf 失败；原配置已重新载入，请检查防护状态"
    }
    pf_token=$(printf '%s\n' "$enable_output" | awk '/Token/ { print $NF; exit }')
  fi

  if [ ! -e "$STATE_FILE" ]; then
    save_initial_state "$pf_was_enabled" "$backup_file" "$pf_token"
  elif [ -n "$pf_token" ]; then
    update_state_token "$pf_token"
  fi

  runtime_rules_complete || fail "防护规则或地址表未完整生效；请运行 status 检查"

  if [ "$mode" = "install" ]; then
    install_daemon
    say "${PRODUCT_NAME} 已安装。"
    say "已保护的物理接口：$(printf '%s' "$interfaces" | paste -sd ',' -)"
    say "自动守护：已启用"
    say "请继续运行：sudo ${INSTALL_PATH} verify"
  else
    /bin/rm -rf "$TEMP_DIR"
    TEMP_DIR=""
  fi
}

watch_rules() {
  require_root watch
  assert_secure_installation_paths
  while :; do
    if ! configuration_complete; then
      install_rules repair >/dev/null 2>&1
    elif ! runtime_rules_complete; then
      ensure_pf_runtime
    fi
    /bin/sleep 10
  done
}

route_interface() {
  local family address
  family=$1
  address=$2
  if [ "$family" = "inet6" ]; then
    /sbin/route -n get -inet6 "$address" 2>/dev/null | awk '/interface:/ { print $2; exit }'
  else
    /sbin/route -n get "$address" 2>/dev/null | awk '/interface:/ { print $2; exit }'
  fi
}

classify_route() {
  local interface interfaces
  interface=$1
  interfaces=$2
  case "$interface" in
    utun*) say "代理隧道" ;;
    "") say "不可用" ;;
    *)
      if printf '%s\n' "$interfaces" | grep -qx "$interface"; then
        say "物理接口"
      else
        say "其他接口 ${interface}"
      fi
      ;;
  esac
}

proxy_health() {
  local proxy_info enabled host port
  proxy_info=$(/usr/sbin/scutil --proxy 2>/dev/null || true)
  enabled=$(printf '%s\n' "$proxy_info" | awk '/HTTPEnable/ { print $3; exit }')
  host=$(printf '%s\n' "$proxy_info" | awk '/HTTPProxy/ { print $3; exit }')
  port=$(printf '%s\n' "$proxy_info" | awk '/HTTPPort/ { print $3; exit }')

  if [ "$enabled" = "1" ] && { [ "$host" = "127.0.0.1" ] || [ "$host" = "localhost" ]; } && [ -n "$port" ]; then
    if /usr/bin/nc -z -G 1 "$host" "$port" >/dev/null 2>&1; then
      say "可用"
    else
      say "已配置但不可达"
    fi
  else
    say "未检测到本地 HTTP 代理"
  fi
}

status_rules() {
  local interfaces pf_now installed covered ipv4_if ipv6_if daemon tables v6_status
  require_root status
  interfaces=$(physical_interfaces)
  [ -n "$interfaces" ] || fail "没有识别到物理网络接口"

  pf_now=$(pf_status || true)
  [ -n "$pf_now" ] || pf_now="未知"
  if configuration_complete; then
    installed="是"
  else
    installed="否"
  fi
  if daemon_active; then
    daemon="运行中"
  else
    daemon="未运行"
  fi

  covered="否"
  if runtime_rules_complete; then
    covered="是"
  fi
  tables="不完整（请重新运行 install）"
  if runtime_table_complete anthropic_ipv4 "$ANTHROPIC_IPV4"; then
    tables="完整（2/2）"
  fi
  v6_status="未确认有效阻断"
  if [ "$covered" = "是" ]; then
    v6_status="已阻断（保留局域网与链路本地）"
  fi

  ipv4_if=$(route_interface inet 160.79.104.1 || true)
  ipv6_if=$(route_interface inet6 2607:6bc0::1 || true)

  say "${PRODUCT_NAME} ${PRODUCT_VERSION}"
  say "安装状态：${installed}"
  say "pf 状态：${pf_now}"
  say "自动守护：${daemon}"
  say "物理接口覆盖及阻断规则：${covered}"
  say "官方入站 IPv4 网段：${tables}"
  say "本地代理：$(proxy_health)"
  say "物理出口公网 IPv6：${v6_status}"
  say "Anthropic IPv4 当前路由类别：$(classify_route "$ipv4_if" "$interfaces")"
  say "Anthropic IPv6 当前路由类别：$(classify_route "$ipv6_if" "$interfaces")"

  [ "$installed" = "是" ] && [ "$pf_now" = "Enabled" ] && [ "$covered" = "是" ] && [ "$daemon" = "运行中" ]
}

# A probe owns one scoped host route. A lookup falling back to a different
# destination is not that route. A matching prefix with a changed gateway or
# interface belongs to someone else now and must not be removed.
test_route_state() {
  local info destination gateway interface flags
  info=$(/sbin/route -n get -host -ifscope "$VERIFY_INTERFACE" "$VERIFY_ADDRESS" 2>/dev/null) || return 1
  destination=$(printf '%s\n' "$info" | awk '/^[[:space:]]*destination:/ {print $2; exit}')
  gateway=$(printf '%s\n' "$info" | awk '/^[[:space:]]*gateway:/ {print $2; exit}')
  interface=$(printf '%s\n' "$info" | awk '/^[[:space:]]*interface:/ {print $2; exit}')
  flags=$(printf '%s\n' "$info" | awk '/^[[:space:]]*flags:/ {print $2; exit}')
  [ "$destination" = "$VERIFY_ADDRESS" ] || return 3
  case "$flags" in *HOST*IFSCOPE*) ;; *) return 3 ;; esac
  [ "$gateway" = "$VERIFY_GATEWAY" ] && [ "$interface" = "$VERIFY_INTERFACE" ] || return 4
}

remove_test_route() {
  local state
  [ "$VERIFY_ROUTE_ADDED" -eq 1 ] || return 0
  state=0
  test_route_state || state=$?
  if [ "$state" -eq 3 ]; then
    VERIFY_ROUTE_ADDED=0
    return 0
  fi
  [ "$state" -eq 0 ] || return 1
  # Preserve any route with the same destination on another interface.
  /sbin/route -n delete -host -ifscope "$VERIFY_INTERFACE" "$VERIFY_ADDRESS" "$VERIFY_GATEWAY" >/dev/null 2>&1 || :
  state=0
  test_route_state || state=$?
  [ "$state" -eq 3 ] || return 1
  VERIFY_ROUTE_ADDED=0
}

verify_rule_packets() {
  local rules
  rules=$(/sbin/pfctl -a "$ANCHOR_NAME" -vvsr 2>/dev/null) || return 1
  printf '%s\n' "$rules" | awk -v label="${ANCHOR_NAME}.verify" '
    /^@?[0-9]*[[:space:]]*block / {found=(index($0, "label \"" label "\"") > 0)}
    found && /Packets:/ {
      for (i=1;i<=NF;i++) if ($i=="Packets:") {print $(i+1); exit}
    }
  '
}

verify_rules() {
  local default_info default_interface default_gateway interfaces verify_anchor
  local candidate bait_address bait_port packets
  require_root verify
  assert_secure_installation_paths
  status_rules >/dev/null || fail "安装状态不完整，请先运行 sudo \"${0}\" install"

  default_info=$(/sbin/route -n get default 2>/dev/null) || unverified "无法读取默认物理出口"
  default_interface=$(printf '%s\n' "$default_info" | awk '/interface:/ { print $2; exit }')
  default_gateway=$(printf '%s\n' "$default_info" | awk '/gateway:/ { print $2; exit }')
  [ -n "$default_interface" ] && [ -n "$default_gateway" ] || unverified "默认物理出口不完整"
  interfaces=$(physical_interfaces) || unverified "物理网卡发现失败"
  printf '%s\n' "$interfaces" | grep -qx "$default_interface" \
    || unverified "默认出口不是受保护的物理接口"

  VERIFY_ACTIVE=1
  VERIFY_GATEWAY=$default_gateway
  VERIFY_INTERFACE=$default_interface
  bait_address=""
  for candidate in $BAIT_CANDIDATES; do
    VERIFY_ADDRESS=${candidate%:*}
    bait_port=${candidate##*:}
    # Scoped routes plus a bound socket affect only the test's physical path.
    if /sbin/route -n add -host -ifscope "$VERIFY_INTERFACE" "$VERIFY_ADDRESS" "$VERIFY_GATEWAY" >/dev/null 2>&1; then
      VERIFY_ROUTE_ADDED=1
      test_route_state || fail "无法确认测试路由的完整身份"
      if /usr/bin/nc -n -b "$VERIFY_INTERFACE" -z -G 3 "$VERIFY_ADDRESS" "$bait_port" >/dev/null 2>&1; then
        bait_address=$VERIFY_ADDRESS
        break
      fi
      remove_test_route || fail "不可达诱饵的测试路由清理失败"
    fi
  done
  [ -n "$bait_address" ] || unverified "所有诱饵基线均不可达；没有证明阻断有效"

  TEMP_DIR=$(make_temp_dir)
  verify_anchor="${TEMP_DIR}/anchor.verify"
  /bin/cp "$ANCHOR_FILE" "$verify_anchor"
  say "block drop out quick on ${default_interface} inet from any to ${bait_address} label \"${ANCHOR_NAME}.verify\"" >> "$verify_anchor"
  /sbin/pfctl -nf "$verify_anchor" >/dev/null
  VERIFY_RULES_CHANGED=1
  /sbin/pfctl -a "$ANCHOR_NAME" -f "$verify_anchor" >/dev/null
  if /usr/bin/nc -n -b "$VERIFY_INTERFACE" -z -G 3 "$bait_address" "$bait_port" >/dev/null 2>&1; then
    fail "阻断失败；将尝试恢复正式防护与测试路由"
  fi
  packets=$(verify_rule_packets) || unverified "无法读取诱饵规则命中证据"
  case "$packets" in ''|*[!0-9]*) unverified "没有有效的诱饵命中计数" ;; esac
  [ "$packets" -gt 0 ] || unverified "诱饵连接失败，但没有本项目规则命中证据"

  /sbin/pfctl -a "$ANCHOR_NAME" -f "$ANCHOR_FILE" >/dev/null
  runtime_rules_complete || fail "正式规则恢复后的回读检查失败"
  VERIFY_RULES_CHANGED=0
  /usr/bin/nc -n -b "$VERIFY_INTERFACE" -z -G 3 "$bait_address" "$bait_port" >/dev/null 2>&1 \
    || fail "恢复后的基线连接失败"
  cleanup || fail "测试清理未完整成功"
  say "配置检查：通过（两个官方入站 IPv4 网段及全部物理接口）。"
  say "实测通过：IPv4/TCP 诱饵可达→本项目规则命中并阻断→恢复可达；测试路由已清理。"
  say "未实测：Anthropic 正式目标、IPv6、UDP/QUIC；本次测试未连接 Anthropic。"
}

uninstall_rules() {
  local pf_candidate timestamp pf_was_enabled pf_token remaining_rules previous_pf
  require_root uninstall
  assert_secure_installation_paths
  [ -r "$PF_CONF" ] || fail "找不到 ${PF_CONF}"

  # Do not remove rules while a registered watcher could recreate them.
  if /bin/launchctl print "system/${DAEMON_LABEL}" >/dev/null 2>&1; then
    /bin/launchctl bootout "system/${DAEMON_LABEL}" >/dev/null 2>&1 || fail "守护服务停止失败；防护与安装文件均保留"
  fi
  if /bin/launchctl print "system/${DAEMON_LABEL}" >/dev/null 2>&1; then
    fail "守护服务仍已注册，拒绝继续卸载"
  fi
  TEMP_DIR=$(make_temp_dir)
  pf_candidate="${TEMP_DIR}/pf.conf"
  previous_pf="${TEMP_DIR}/pf.before"
  /bin/cp -p "$PF_CONF" "$previous_pf"
  strip_managed_block "$PF_CONF" "$pf_candidate"
  /sbin/pfctl -nf "$pf_candidate" >/dev/null

  timestamp=$(/bin/date '+%Y%m%d-%H%M%S')
  /bin/mkdir -p "$BACKUP_DIR"
  /bin/cp -p "$PF_CONF" "${BACKUP_DIR}/pf.conf.before-uninstall.${timestamp}"

  pf_was_enabled=1
  pf_token=""
  if [ -r "$STATE_FILE" ]; then
    pf_was_enabled=$(awk -F= '/^PF_WAS_ENABLED=/ { print $2; exit }' "$STATE_FILE")
    pf_token=$(awk -F= '/^PF_TOKEN=/ { print $2; exit }' "$STATE_FILE")
  fi

  /usr/bin/install -o root -g wheel -m 644 "$pf_candidate" "$PF_CONF"
  if ! /sbin/pfctl -f "$PF_CONF" >/dev/null; then
    /usr/bin/install -o root -g wheel -m 644 "$previous_pf" "$PF_CONF"
    /sbin/pfctl -f "$PF_CONF" >/dev/null 2>&1 || fail "卸载载入与回滚失败；防护文件和状态均保留，请检查 pf"
    /bin/launchctl bootstrap system "$DAEMON_PLIST" >/dev/null 2>&1 || fail "卸载已中止；规则已重新载入，但守护服务恢复失败"
    fail "卸载已中止，原配置已重新载入；请运行 status 复核"
  fi
  remaining_rules=$(/sbin/pfctl -sr 2>/dev/null) || fail "无法回读卸载后的主规则；状态与备份保留"
  if printf '%s\n' "$remaining_rules" | grep -Fq "anchor \"${ANCHOR_NAME}\""; then
    fail "主规则仍引用本项目；拒绝报告卸载成功"
  fi
  /bin/rm -f "$ANCHOR_FILE" "$DAEMON_PLIST"

  if [ "$pf_was_enabled" = "0" ]; then
    if [ -n "$pf_token" ]; then
      /sbin/pfctl -X "$pf_token" >/dev/null 2>&1 || fail "无法释放本项目 pf 引用；安装状态与备份保留供检查"
    else
      /sbin/pfctl -d >/dev/null 2>&1 || fail "无法恢复安装前 pf 状态；状态文件保留供检查"
    fi
  fi

  [ ! -e "$ANCHOR_FILE" ] && [ ! -e "$DAEMON_PLIST" ] || fail "防护文件仍有残留"
  /bin/rm -rf "$STATE_DIR"
  /bin/rm -f "$INSTALL_PATH"
  say "${PRODUCT_NAME} 已卸载，安装前后的 pf.conf 备份保留在 ${BACKUP_DIR}。"
}

usage() {
  say "用法：${0} <check|install|status|verify|uninstall>"
}

check_environment() {
  local interfaces
  interfaces=$(physical_interfaces)
  [ -n "$interfaces" ] || fail "没有识别到物理网络接口"
  say "${PRODUCT_NAME} ${PRODUCT_VERSION}"
  say "物理接口：$(printf '%s' "$interfaces" | paste -sd ',' -)"
  say "本地代理：$(proxy_health)"
  say "将阻断的目标：Anthropic 官方 IPv4，以及物理出口上的公网 IPv6/NAT64"
  say "不会修改 Clash Verge、Claude、账号、钥匙串或系统代理设置。"
}

command=${1:-}
case "$command" in
  check) check_environment ;;
  install) install_rules ;;
  status) status_rules ;;
  verify) verify_rules ;;
  uninstall) uninstall_rules ;;
  watch) watch_rules ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
